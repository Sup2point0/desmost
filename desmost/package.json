{
  "name": "desmost",
  "author": "Sup#2.0",
  "version": "0.5.1",
  "license": "MIT",

  "description": "A tiny DSL for compiling LaTeX to Desmos",
  "keywords": [
    "desmos", "latex", "compiler"
  ],

  "homepage": "https://sup2point0.github.io/desmost",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Sup2point0/desmost.git"
  },
  "bugs": {
    "url": "https://github.com/Sup2point0/desmost/issues"
  },
  
  "type": "module",
  "files": [
    "./src/",
    "./dist/",
    "./svelte/",
    "package.json",
    "LICENCE",
    "README.md"
  ],
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./svelte": {
      "import": "./svelte/desmost.svelte"
    },
    "./internal": {
      "import": "./dist/index.internal.js",
      "types": "./dist/index.internal.d.ts"
    }
  },

  "scripts":
  {
    "build":    "nu build.nu",
      "buildx": "nu build.nu full",

    "test":     "vitest run",
      "testw":  "vitest",

    "check":    "npx oxlint src",

    "prepublishOnly": "npm run test && npm run buildx"
  },

  "dependencies":
  {
    "json5": "^2.2"
  },

  "peerDependencies":
  {
    "@types/desmos": "1.11",
    "svelte": "^5.0"
  },

  "devDependencies":
  {
    "@types/desmos": "1.11",
    "@types/node": "^26.0",
    "oxlint": "^1.78",
    "oxlint-tsgolint": "^7.0",
    "tsc-alias": "^1.9",
    "typescript": "^6.0",
    "vitest": "^4.0"
  }
}
