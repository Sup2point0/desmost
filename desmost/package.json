{
  "name": "desmost",
  "author": "Sup#2.0",
  "version": "0.1.0",
  "license": "MIT",

  "description": "A tiny DSL for compiling LaTeX to Desmos",
  "keywords": [
    "desmos", "latex", "desmost"
  ],

  "homepage": "https://sup2point0.github.io/desmost",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Sup2point0/desmost.git"
  },
  "bugs": {
    "url": "https://github.com/Sup2point0/desmost/issues"
  },
  
  "type": "module",
  "files": [
    "./src/",
    "./dist/",
    "package.json"
  ],
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./internal": {
      "import": "./dist/index.internal.js",
      "types": "./dist/index.internal.d.ts"
    }
  },

  "scripts": {
    "build":   "tsc -p ./tsconfig.build.json",

    "test":    "vitest run",
      "testw": "vitest",

    "check":   "npx oxlint src"
  },

  "dependencies":
  {
    "json5": "^2.2"
  },

  "devDependencies":
  {
    "@eslint/js": "^10.0",
    "@types/desmos": "1.11",
    "@types/node": "^26.0",
    "oxlint": "^1.78",
    "oxlint-tsgolint": "^7.0",
    "typescript": "^7.0",
    "vitest": "^4.0"
  }
}
