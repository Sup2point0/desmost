{
  "extends": "./tsconfig.json",
  "include": [
    "./src/",
  ],
  "compilerOptions": {
    "rootDir": "./src/",
    "outDir": "./dist/",
    "target": "esnext",
    "sourceMap": true,
    "declaration": true,
    "declarationMap": true,
    "removeComments": true,
  },
  "tsc-alias": {
    "resolveFullPaths": true
  }
}
